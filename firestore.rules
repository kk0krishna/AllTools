rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read stats
    match /toolStats/{document} {
      allow read: if true;
      allow update: if true; // In production, restrict this to only increment operations if possible
      allow create: if true;
    }
    // Allow write-only for pageViews
    match /pageViews/{document} {
      allow create: if true;
      allow read: if false; // Keep raw logs private
    }
    // Allow authenticated users to manage their own mood logs within their user document
    match /users/{userId}/mood_logs/{document} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Allow authenticated users to manage their movie preferences
    // Any authenticated user can read (needed for Movie Match feature)
    // Only the owner can write
    match /user_movie_preferences/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // User movie profiles (name, favorite genres) — readable by others for Match
    match /user_movie_profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
